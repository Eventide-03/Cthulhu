    content/newtab/widgets/notes/notes.js             (content/newtab/widgets/notes/notes.js)
    content/newtab/widgets/search/search.js           (content/newtab/widgets/search/search.js)
    content/newtab/widgets/moon/moon.js               (content/newtab/widgets/moon/moon.js)
    content/newtab/widgets/gradient/gradient.js       (content/newtab/widgets/gradient/gradient.js)
    content/newtab/widgets/orb/orb.js                 (content/newtab/widgets/orb/orb.js)
    content/newtab/widgets/orb/assets/orb.png         (content/newtab/widgets/orb/assets/orb.png)
    content/newtab/widgets/orb/assets/orb.json        (content/newtab/widgets/orb/assets/orb.json)
    content/newtab/widgets/feature-request/feature-request.js (content/newtab/widgets/feature-request/feature-request.js)
# Feature modules (see content/modules/README.md). jar.mn does not glob, so each
# module file is listed explicitly:
    content/modules/index.json                 (content/modules/index.json)
    content/modules/example/manifest.json      (content/modules/example/manifest.json)
    content/modules/example/example.js         (content/modules/example/example.js)
    content/modules/example/example.css        (content/modules/example/example.css)
    content/modules/example/assets/idle.png    (content/modules/example/assets/idle.png)
    content/modules/example/assets/idle.json   (content/modules/example/assets/idle.json)
    content/modules/example/assets/logo.png    (content/modules/example/assets/logo.png)
