# =============================================================================
# Windows x64 build config.
#
# ⚠️  NOT YET VALIDATED ON A REAL WINDOWS BUILD. Believed correct, but untested
#     until the post-Phase-8 Windows shakedown. The CI job for Windows is
#     deliberately continue-on-error so problems here cannot block Mac releases.
# =============================================================================

ac_add_options --enable-application=browser

# TARGET: intentionally NOT set.
#
# The previous value here was `--target=x86_64-pc-mingw32`, which does not just
# misbuild -- it makes configure abort outright. build/moz.configure/
# init.configure's check_mingw_triplet() calls die() on any *-mingw32 or
# *-mingw64 triplet: "no longer supported, try ...-windows-gnu or
# ...-windows-msvc instead".
#
# A native x64 build on a Windows host needs no --target at all: the host triple
# is already x86_64-pc-windows-msvc. Leaving it implicit also keeps this file
# correct if an arm64 Windows target is added later. If an explicit triple is
# ever wanted, it is `x86_64-pc-windows-msvc` (NOT mingw32).

ac_add_options --enable-hardening
ac_add_options --enable-rust-simd
ac_add_options --enable-release
ac_add_options --enable-optimize
ac_add_options --disable-debug

# Auto-updates: kept enabled, matching macOS.
ac_add_options --enable-updater

# Crash reporter: kept ON here while macOS drops it -- an untested platform is
# exactly where crash data is most useful. Note this is the ONLY intentional
# behavioural difference between the two platform configs.
ac_add_options --enable-crashreporter

# Standalone JS shell. Not needed to ship a browser and it lengthens the build.
# Dropped on Windows: the runner is the tightest environment we build in (4
# cores / 16 GB) and this is pure extra work for something we do not ship.
# ac_add_options --enable-js-shell

# PARALLELISM IS A MEMORY LIMIT HERE, NOT A SPEED KNOB.
#
# With no MOZ_MAKE_FLAGS this defaulted to -j4 (one per core), and the build
# died after 81 minutes with four clang processes and rustc competing for RAM:
#   LLVM ERROR: out of memory
#   clang-cl: error: unable to execute command: ...
#             The paging file is too small for this operation to complete. (0x5AF)
#   rustc-LLVM ERROR: out of memory -- could not compile `gkrust`
#
# gkrust is a single enormous crate and is the peak-memory moment of the whole
# build, so it must not be sharing the machine with three other compilers.
# macOS sets -j4 and is fine; the Windows runner is not the same machine.
mk_add_options MOZ_MAKE_FLAGS="-j2"

# DEBUG SYMBOLS OFF -- this is what actually gets gkrust to link.
#
# -j2 alone was not enough; the build still died at 88 minutes with
#   rustc-LLVM ERROR: out of memory -- could not compile `gkrust`
# config/makefiles/rust.mk:371 forces `-C codegen-units=1` on target recipes,
# so rustc compiles gkrust as ONE LLVM module and holds all of its debug info
# in memory at once. build/moz.configure/rust.configure only appends
# `debuginfo=` when --enable-debug-symbols is set, so turning symbols off
# removes the single largest allocation in the build.
#
# TRADE-OFF, deliberate: --enable-crashreporter is still on above, and without
# symbols those minidumps cannot be symbolicated. Kept the reporter anyway --
# a crash we can count is worth more than one we never hear about, and this is
# reversible the moment Windows builds on a machine with real memory.
ac_add_options --disable-debug-symbols

# Compiler cache -- same guard as macOS, see that file for the rationale.
if command -v sccache >/dev/null 2>&1; then
  ac_add_options --with-ccache=sccache
fi

# Disable telemetry and tracking
mk_add_options MOZ_TELEMETRY_REPORTING=
mk_add_options MOZ_DATA_REPORTING=
