cthulhu.jar:
# Registers chrome://cthulhu/content/ -> the "content/" tree inside cthulhu.jar.
# Assets live under content/assets/, i.e. chrome://cthulhu/content/assets/<file>,
# so CSS/JS can reference bundled art. (Left as a chrome-only package: no
# contentaccessible flag, so web content cannot load these.)
% content cthulhu %content/
# Content-accessible package exposing ONLY the cursor images to web content, so
# the global cursor sheet's url()s load inside pages (a plain chrome://cthulhu/
# URL is blocked in content). Maps chrome://cthulhu-cursors/content/ -> the
# cursors module's assets/ dir. Nothing else is exposed to content.
% content cthulhu-cursors %content/modules/cursors/assets/ contentaccessible=yes
    content/theme.css                   (content/theme.css)
    content/browser.css                 (content/browser.css)
    content/browser.js                  (content/browser.js)
    content/QuitOnLastWindowClose.sys.mjs (content/QuitOnLastWindowClose.sys.mjs)
    content/loader.js                   (content/loader.js)
    content/sprite.js                   (content/sprite.js)
    content/sprite.css                  (content/sprite.css)
    content/assets/toolbar-badge.svg    (assets/toolbar-badge.svg)
# Home / new-tab page (about:cthulhu; registered by AboutCthulhu.sys.mjs):
    content/newtab/index.html               (content/newtab/index.html)
    content/newtab/newtab.css               (content/newtab/newtab.css)
    content/newtab/newtab.js                (content/newtab/newtab.js)
    content/newtab/AboutCthulhu.sys.mjs     (content/newtab/AboutCthulhu.sys.mjs)
# Browser-wide file picker (Opera-GX-style): a JSWindowActor (registration +
# parent/child) that intercepts <input type=file> clicks in web content.
    content/newtab/FilePicker.sys.mjs                (content/newtab/FilePicker.sys.mjs)
    content/newtab/CthulhuFilePickerParent.sys.mjs   (content/newtab/CthulhuFilePickerParent.sys.mjs)
    content/newtab/CthulhuFilePickerChild.sys.mjs    (content/newtab/CthulhuFilePickerChild.sys.mjs)
# Vendored GridStack 13 (MIT; grid engine for the dashboard). Structural css +
# UMD bundle; see vendor/gridstack/VERSION.txt and the bundled LICENSE.
    content/newtab/vendor/gridstack/gridstack-all.js  (content/newtab/vendor/gridstack/gridstack-all.js)
    content/newtab/vendor/gridstack/gridstack.css     (content/newtab/vendor/gridstack/gridstack.css)
# Widget system core + shared art (settings icon, moon strip):
    content/newtab/widgets.js                         (content/newtab/widgets.js)
    content/newtab/assets/settings-icon.png           (content/newtab/assets/settings-icon.png)
    content/newtab/assets/moon.png                    (content/newtab/assets/moon.png)
    content/newtab/widgets/index.json                 (content/newtab/widgets/index.json)
# Starter widgets (each self-contained; palette auto-populates from these):
    content/newtab/widgets/clock/clock.js             (content/newtab/widgets/clock/clock.js)
    content/newtab/widgets/quick-links/quick-links.js (content/newtab/widgets/quick-links/quick-links.js)
    content/newtab/widgets/folder/folder.js           (content/newtab/widgets/folder/folder.js)
# calendar widget (gcal.js is pulled in by calendar.js; the loader only
# auto-loads <id>/<id>.js, see the widget's README):
    content/newtab/widgets/calendar/calendar.js       (content/newtab/widgets/calendar/calendar.js)
    content/newtab/widgets/calendar/gcal.js           (content/newtab/widgets/calendar/gcal.js)
# pet widget (art slots: assets/<id>.png + <id>.json, listed in assets/pets.json):
    content/newtab/widgets/pet/pet.js                 (content/newtab/widgets/pet/pet.js)
    content/newtab/widgets/pet/assets/pets.json       (content/newtab/widgets/pet/assets/pets.json)
    content/newtab/widgets/pet/assets/cat.png         (content/newtab/widgets/pet/assets/cat.png)
