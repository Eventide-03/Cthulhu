diff --git a/browser/app/distribution/moz.build b/browser/app/distribution/moz.build
index b174449a09895020bfda84645b85deebe42c7be8..957268bc0d4845b07659a17bebae9c8f78e11293 100644
--- a/browser/app/distribution/moz.build
+++ b/browser/app/distribution/moz.build
@@ -8,3 +8,15 @@ if CONFIG["BUILT_BY_MOZILLA"]:
     FINAL_TARGET_FILES.distribution += [
         "distribution.ini",
     ]
+
+# Cthulhu: ship distribution.ini unconditionally (upstream only does so for
+# Mozilla-official builds) so the build carries a distribution id, which is
+# visible in about:support and read by distribution-aware code paths.
+#
+# uBlock Origin was previously bundled here as a distribution addon. It is no
+# longer shipped: vendoring the XPI redistributes a GPLv3 binary, which carries
+# its own attribution obligations in a public repo, and an AMO install stays
+# current on its own without us re-vendoring the file on every release.
+FINAL_TARGET_FILES.distribution += [
+    "distribution.ini",
+]
