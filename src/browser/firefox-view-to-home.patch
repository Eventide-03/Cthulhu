+        // tab into the pinned zone and closes the original -- so the dropped
+        // tab vanishes and a copy appears pinned. Membership cannot misfire.
+        if (!gBrowser.tabs.includes(tab)) {
+          tab = gBrowser.adoptTab(tab);
+        }
+        if (tab && !tab.pinned) {
+          gBrowser.pinTab(tab);
+        }
+      }
+    });
   },
 };
