diff --git a/browser/installer/package-manifest.in b/browser/installer/package-manifest.in
--- a/browser/installer/package-manifest.in
+++ b/browser/installer/package-manifest.in
@@ -234,6 +234,15 @@
 @RESPATH@/browser/chrome/browser.manifest
 @RESPATH@/chrome/toolkit@JAREXT@
 @RESPATH@/chrome/toolkit.manifest
+; Cthulhu chrome overlay -- chrome://cthulhu/ (theme/jar.mn, registered by
+; theme/moz.build). THIS FILE IS AN ALLOWLIST: `mach package` copies only what
+; is named here, so omitting these two lines does not warn, it silently ships a
+; browser with no home page, no widgets, no theme and no Home button -- which is
+; exactly what v1.0.0 and the first v1.0.1 did on BOTH platforms. Local `mach
+; build` never runs the packager (it uses loose files under dist/bin), so this
+; is invisible in development and only appears in a packaged build.
+@RESPATH@/chrome/cthulhu@JAREXT@
+@RESPATH@/chrome/cthulhu.manifest
 #ifdef MOZ_GTK
 @RESPATH@/browser/chrome/icons/default/default16.png
 @RESPATH@/browser/chrome/icons/default/default32.png
@@ -270,6 +279,10 @@
 ; All the pref files must be part of base to prevent migration bugs
 @RESPATH@/browser/@PREF_DIR@/firefox.js
 @RESPATH@/browser/@PREF_DIR@/firefox-branding.js
+; Cthulhu default prefs (browser/moz.build JS_PREFERENCE_FILES). Without this
+; the branding file Surfer generates wins unopposed, which is why a packaged
+; build greeted the user with Zen Browser's onboarding.
+@RESPATH@/browser/@PREF_DIR@/cthulhu.js
 @RESPATH@/greprefs.js
 @RESPATH@/defaults/autoconfig/prefcalls.js
 @RESPATH@/browser/defaults/permissions
