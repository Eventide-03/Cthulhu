; ---------------------------------------------------------------------------
; CTHULHU: this file is vendored so we control the update URL.
;
; It is copied over engine/build/application.ini.in by surfer's copy-patches
; step, which runs AFTER the branding step -- and branding rewrites this URL to
; surfer's own simplified path. Copying the whole file (rather than patching)
; makes that ordering safe and idempotent.
;
; RE-SYNC THIS FILE ON EVERY FIREFOX ESR REBASE. It is a full copy of upstream's
; build/application.ini.in with exactly one line changed (the [AppUpdate] URL).
;
; WHY THE URL CARRIES NOTHING BUT CHANNEL AND BUILD TARGET:
; Firefox's stock URL puts %VERSION%, %BUILD_ID%, %OS_VERSION%, %LOCALE% and
; %SYSTEM_CAPABILITIES% (which expands to the CPU instruction set and the
; installed RAM) into the PATH. Those vary per client, so a static file host
; would need a file for every combination -- impossible. An earlier version of
; this file moved them into the QUERY STRING, which fixed that: GitHub Pages
; addresses the file by path and ignores the query.
;
; But "ignores" cuts both ways. Nothing we can act on ever reaches us from those
; parameters -- Pages serves a static file and gives us no request log -- so
; they were pure fingerprint: a precise version, a 14-digit build timestamp and
; an exact OS build number, handed to GitHub next to the client's IP address on
; every check. They are gone.
;
; What remains is the minimum that has to be there, because it SELECTS THE FILE:
;   %CHANNEL%       -- "release"; constant across every shipped build
;   %BUILD_TARGET%  -- e.g. WINNT_x86_64-msvc-x64; OS + architecture, and the
;                      thing that decides which MAR the client is offered
; The client compares the advertised version against its own LOCALLY, so the
; server never needs to be told what version is running. See the docstring in
; tools/update-manifests/generate.py.
;
; Firefox appends "?force=1" itself on a user-initiated check (About dialog) and
; handles the missing "?" correctly -- see UpdateService.sys.mjs, getUpdateURL.
;
; VERIFYING A CHANGE TO THIS LINE: the browser does NOT read this file at
; runtime. The preprocessed application.ini is turned into
; obj/build/application.ini.h, compiled in as gAppData->updateURL, and served to
; JS as Services.appinfo.updateURL (nsAppRunner.cpp). `mach build faster`
; regenerates the .ini and the .h but does not relink, so a locally running
; build keeps reporting the OLD url until a full build. Check
; obj/build/application.ini.h, not the running app. CI always does a full build,
; and tools/verify-package.py re-reads the packaged application.ini -- the same
; file the header is generated from, so the two cannot disagree.
; ---------------------------------------------------------------------------
#ifdef MOZ_BUILD_APP_IS_BROWSER
; This file is not used. If you modify it and want the application to use
; your modifications, move it under the browser/ subdirectory and start with
; the "-app /path/to/browser/application.ini" argument.
#else
; This file is not used. If you modify it and want the application to use
; your modifications, start with the "-app /path/to/application.ini"
; argument.
#endif
#if 0
; This Source Code Form is subject to the terms of the Mozilla Public
; License, v. 2.0. If a copy of the MPL was not distributed with this
; file, You can obtain one at http://mozilla.org/MPL/2.0/.
#endif
#filter substitution
#include @TOPOBJDIR@/buildid.h
#include @TOPOBJDIR@/source-repo.h
[App]
Vendor=@MOZ_APP_VENDOR@
Name=@MOZ_APP_BASENAME@
RemotingName=@MOZ_APP_REMOTINGNAME@
#ifdef MOZ_APP_DISPLAYNAME
CodeName=@MOZ_APP_DISPLAYNAME@
#endif
Version=@MOZ_APP_VERSION@
#ifdef MOZ_APP_PROFILE
Profile=@MOZ_APP_PROFILE@
#endif
BuildID=@MOZ_BUILDID@
#ifdef MOZ_SOURCE_REPO
SourceRepository=@MOZ_SOURCE_REPO@
#endif
#ifdef MOZ_SOURCE_STAMP
SourceStamp=@MOZ_SOURCE_STAMP@
#endif
ID=@MOZ_APP_ID@

[Gecko]
MinVersion=@GRE_MILESTONE@
MaxVersion=@GRE_MILESTONE@

[XRE]
#ifdef MOZ_PROFILE_MIGRATOR
EnableProfileMigrator=1
#endif

#if MOZ_CRASHREPORTER
[Crash Reporter]
Enabled=1
ServerURL=@MOZ_CRASHREPORTER_URL@/submit?id=@MOZ_APP_ID@&version=@MOZ_APP_VERSION@&buildid=@MOZ_BUILDID@
#endif

#if MOZ_UPDATER
; THE HOST IS LITERAL ON PURPOSE -- do not restore @MOZ_APPUPDATE_HOST@.
;
; That placeholder expands from CONFIG["MOZ_APPUPDATE_HOST"], defaulting to
; aus5.mozilla.org when the key is missing. Upstream never declares the
; configure option, so the default always won and v1.0.0 shipped asking
; Mozilla for its updates. Declaring the option (src/browser/moz-configure.patch)
; populates CONFIG locally -- verified in substs -- but on the CI runners the
; placeholder still expanded to aus5.mozilla.org across two full builds, and
; the divergence was not reproducible locally. Rather than keep guessing at
; 90 minutes a run, the URL no longer depends on that mechanism at all.
;
; SOURCE OF TRUTH is surfer.json's "updateHostname". If these two ever
; disagree the build FAILS: both build jobs compare this file's baked URL
; against surfer.json (see "GUARD: the update URL" in .github/workflows/build.yml).
[AppUpdate]
URL=https://eventide-03.github.io/Cthulhu/updates/%CHANNEL%/%BUILD_TARGET%/update.xml
#endif
